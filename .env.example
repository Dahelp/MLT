# Create a bot with @BotFather and place it in the manager chat.
# Keep real values only in .env.local or the hosting environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payment credentials. Keep real values only in .env.local or the hosting environment.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to "live" only after live payments are approved. Default is the PayPal sandbox.
PAYPAL_MODE=sandbox

# Production order reporting (configured in the protected host-side paypal-config.php).
# database: host, name, user and password; notification_email; telegram_bot_token and telegram_chat_id.
