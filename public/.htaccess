Options -Indexes
ServerSignature Off
LimitRequestBody 12582912

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:vendor|node_modules|tests|scripts|db|drizzle|worker|examples|\.git)(?:/|$) - [F,L,NC]
  RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)(?:[./]|$) - [F,L,NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(?:www\.)?mlt-lifestyle\.com$ [NC]
  RewriteRule ^ https://mlt-lifestyle.com%{REQUEST_URI} [R=308,L]
  RewriteRule ^(en|de|ru|it|pl)/acquisitions/mlt-explorer-preview/?$ /$1/acquisitions/mercedes-benz-v-300-marco-polo/ [R=301,L]
  RewriteRule ^(index\.html)?$ /en/ [R=301,L]
  RewriteCond %{HTTP:Sec-CH-UA-Mobile} "^\?1$" [OR]
  RewriteCond %{HTTP_USER_AGENT} "(iPhone|iPod|Windows Phone|IEMobile|Opera Mini|Android.*Mobile)" [NC]
  RewriteRule ^(en|de|ru|it|pl)(/|/index\.html)?$ $1/mobile-site/index.html [L]
  RewriteCond %{HTTP:Sec-CH-UA-Mobile} "^\?1$" [OR]
  RewriteCond %{HTTP_USER_AGENT} "(iPhone|iPod|Windows Phone|IEMobile|Opera Mini|Android.*Mobile)" [NC]
  RewriteRule ^(en|de|ru|it|pl)/collections/(freedom|signature|concierge|private|honeymoon)(/|/index\.html)?$ $1/collections/$2/mobile-site/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Accept-CH "Sec-CH-UA-Mobile"
  Header always merge Vary "User-Agent"
  Header always merge Vary "Sec-CH-UA-Mobile"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com https://checkout.stripe.com; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  # OSM requires a valid Referer. Share only the origin, never paths or queries.
  Header always set Referrer-Policy "strict-origin"
  <FilesMatch "\.php$">
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)" "expr=%{REQUEST_URI} =~ m#^/(?:en/|de/|ru/|it/|pl/)?scout-passport(?:/|$)#"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<FilesMatch "\.(env|log|ini|ya?ml|lock)$">
  Require all denied
</FilesMatch>

<Files "paypal-config.php">
  Require all denied
</Files>

<Files "booking.php">
  Require all denied
</Files>

<FilesMatch "(?i)(\.(?:sql|sqlite3?|db|bak|old|orig|save|swp|dist|map|ts|tsx|mjs|jsonl|pem|key)$|^(?:composer\.(?:json|lock)|package\.json|pnpm-lock\.yaml|.*config\.php|security\.php|voucher-core\.php|voucher-payments\.php|chat-access\.php|journey-pricing\.php|scout-core\.php)$)">
  Require all denied
</FilesMatch>
