Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} "(iPhone|iPod|Windows Phone|IEMobile|Opera Mini|Android.*Mobile)" [NC]
  RewriteRule ^(en|de|ru)/?$ $1/mobile-site/index.html [L]
  RewriteCond %{HTTP_USER_AGENT} "(iPhone|iPod|Windows Phone|IEMobile|Opera Mini|Android.*Mobile)" [NC]
  RewriteRule ^(en|de|ru)/collections/(freedom|signature|concierge|private|honeymoon)/?$ $1/collections/$2/mobile-site/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<FilesMatch "\.(env|log|ini|ya?ml|lock)$">
  Require all denied
</FilesMatch>

<Files "paypal-config.php">
  Require all denied
</Files>

<Files "booking.php">
  Require all denied
</Files>
